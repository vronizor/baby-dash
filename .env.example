# Required
BB_PUBLIC_URL=https://babybuddy.your-tailnet.ts.net
BB_TOKEN=paste-the-read-only-users-api-key-here

# Optional (defaults shown)
# BB_URL=http://babybuddy:8000
# CHILD_SLUG=
# TZ=Europe/Paris
# ROW_START=18:00
# NIGHT_START=20:00
# NIGHT_END=07:00
# FEED_MERGE_MIN=20
# SLEEP_MERGE_MIN=5
# BASELINE_DAYS=3
# MIN_BASELINE_N=6
# CACHE_TTL_S=60
# AMOUNT_UNIT=ml
# SLEEP_TIMER_REGEX=sleep|nap|sieste|dodo

# compose only
# BB_NETWORK=babybuddy_default   # Baby Buddy's Docker network
# DASH_BIND=127.0.0.1            # 127.0.0.1 = only Caddy on this host; 0.0.0.0 = whole tailnet, no Caddy
# DASH_PORT=8090                 # host port (8080 is often taken)
